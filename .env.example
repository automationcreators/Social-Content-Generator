# Copy to .env and fill in locally. Never commit .env or real values.

# Parent workspace that contains sibling projects (ContentGen, Personal-OS, etc.)
SCG_WORKSPACE_ROOT=/home/example/Documents/workspace

# SQLite database produced by a local ContentGen checkout
CONTENTGEN_DB=/home/example/Documents/workspace/ContentGen/data/database.db

# Directory of projects scanned for examples
ACTIVE_PROJECTS_DIR=/home/example/Documents/workspace/active

# Gemini. Required for live script generation. Leave blank for a static demo.
GOOGLE_API_KEY=

# Google Drive upload target. Create your own folder; do not reuse a shared id from docs.
GDRIVE_FOLDER_ID=

# Directory for the OAuth client JSON (google-drive-credentials.json) and token.pickle.
# Keep this outside the repo.
GOOGLE_CREDENTIALS_DIR=/home/example/.config/social-content-generator

# Optional override for pillar_scripts/test_script_variations.py
# SCRIPT_VARIATION_OUTPUT=./pillar_scripts/test_output.json

# Frontend (also copy frontend/.env.example to frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
